# Template environment webToko — SALIN ke `.env`, dan JANGAN pernah commit `.env` asli.
# Generate secret kuat: openssl rand -base64 48

# Wajib — koneksi database (dipakai Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/webtoko?schema=public

# Wajib — secret JWT. Di production minimal 32 karakter,
# aplikasi menolak start kalau kosong/terlalu pendek.
JWT_SECRET=ganti-dengan-hasil-openssl-rand-base64-48

# Opsional — URL publik untuk metadata/SEO.
# PENTING: semua NEXT_PUBLIC_* ikut terkirim ke browser — jangan pernah taruh rahasia di sini.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
